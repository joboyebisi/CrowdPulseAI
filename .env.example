# Twitch Developer Console: https://dev.twitch.tv/console/apps
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# Generate with: openssl rand -hex 32
SESSION_SECRET=

# Preferred agent provider for moment packaging and social drafts.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Optional secondary provider. Used when Gemini is not configured.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

# Hype detector tuning
HYPE_THRESHOLD=5
HYPE_WINDOW_SECONDS=20
HYPE_COOLDOWN_SECONDS=90

# Canonical base URL used for links and the Twitch OAuth callback.
# Register {NEXT_PUBLIC_APP_URL}/api/auth/twitch/callback in Twitch.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# AWS serverless backend. Keep the internal secret server-only.
AWS_BACKEND_URL=
AWS_INTERNAL_API_SECRET=

# Optional live football feed. Without it, the UI uses the labelled Clásico replay.
SPORTMONKS_API_TOKEN=
