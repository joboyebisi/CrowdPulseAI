# Twitch Developer Console: https://dev.twitch.tv/console/apps
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
TWITCH_REDIRECT_URI=http://localhost:3000/api/auth/twitch/callback

# Generate with: openssl rand -hex 32
SESSION_SECRET=

# Optional. Without this, captions use a transparent deterministic fallback.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

# Hype detector tuning
HYPE_THRESHOLD=5
HYPE_WINDOW_SECONDS=20
HYPE_COOLDOWN_SECONDS=90

# Public base URL used in links
NEXT_PUBLIC_APP_URL=http://localhost:3000
