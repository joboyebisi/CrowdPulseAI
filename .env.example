# Twitch Developer Console: https://dev.twitch.tv/console/apps
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
TWITCH_REDIRECT_URI=http://localhost:3000/api/auth/twitch/callback

# Generate with: openssl rand -hex 32
SESSION_SECRET=

# Preferred agent provider for moment packaging and social drafts.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Optional secondary provider. Used when Gemini is not configured.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

# Hype detector tuning
HYPE_THRESHOLD=5
HYPE_WINDOW_SECONDS=20
HYPE_COOLDOWN_SECONDS=90

# Public base URL used in links
NEXT_PUBLIC_APP_URL=http://localhost:3000

# AWS serverless backend. Keep the internal secret server-only.
AWS_BACKEND_URL=
AWS_INTERNAL_API_SECRET=
